# Export these variables in your shell; this file is documentation, not auto-loaded.
A11Y_AI_PROVIDER=ollama
A11Y_OLLAMA_URL=http://127.0.0.1:11434
# For compatible APIs instead: A11Y_AI_PROVIDER=compatible
# A11Y_AI_BASE_URL=https://api.openai.com/v1
A11Y_AI_MODEL=
A11Y_AI_KEY=
# Optional: a multimodal model; defaults to A11Y_AI_MODEL.
A11Y_VISION_MODEL=
# Local, single-employee prototype. Do not expose the web server to a network.
A11Y_DATA_DIR=.data
A11Y_COMPANY_ID=demo-company
A11Y_USER_ID=demo-employee
A11Y_ROLES=employee,engineering

# Optional transparent character artwork (current chameleon is a placeholder).
# A11Y_MASCOT_IMAGE=/absolute/path/candy-man.png

# Candidate to benchmark for stronger local multimodal reasoning:
# A11Y_AI_MODEL=qwen3.5:9b
# Context is bounded to avoid crowding out current screen evidence.
A11Y_OLLAMA_CONTEXT=16384
# Use default model behavior, or explicitly true/false if the model supports it.
A11Y_OLLAMA_THINKING=default
# How long Ollama keeps the model loaded between requests (default 30m; 5m frees memory sooner).
A11Y_OLLAMA_KEEP_ALIVE=30m
# Width of the screenshot copy sent to the model (512-2048, default 1280). Ollama's
# Qwen-VL runner upscales images to at least 1024 tokens (~1M pixels), so smaller
# copies do not save time there. OCR text and click checks use the full capture.
A11Y_MODEL_IMAGE_WIDTH=1280
# Answer "look up X" / "search for X" in the companion from Wikipedia instead of opening
# a browser. Off by default because it sends the phrase to wikipedia.org.
# A11Y_WEB_ANSWERS=1
